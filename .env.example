# ─────────────────────────────────────────────────────────────
# StockPilot environment variables
# Copy to .env.local (development) or set in your hosting provider.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# MongoDB. Atlas (or any replica set) is recommended so multi-document
# transactions are used for sales/purchases. A standalone local mongod also
# works (compensating writes are used instead). Examples:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/stockpilot?retryWrites=true&w=majority
#   mongodb://127.0.0.1:27017/stockpilot?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/stockpilot
# Optional: separate database used by `bun run test:integration`
MONGODB_URI_TEST=

# Auth — use a long random string (at least 32 characters)
# e.g. `bun -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Session lifetime in days (default 7)
SESSION_DAYS=7

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in / sign-up (optional — the button only appears when both are set)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to NEXT_PUBLIC_APP_URL + /api/auth/google/callback)
GOOGLE_REDIRECT_URI=

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with your SECRET KEY (HMAC SHA512).
# Leave empty to use PAYSTACK_SECRET_KEY; set only if you proxy webhooks with a different key.
PAYSTACK_WEBHOOK_SECRET=
# Optional: "true" to only accept webhooks from Paystack's published IPs
PAYSTACK_ENFORCE_IP_WHITELIST=false

# Cron — protects /api/cron/* (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Email (optional). If RESEND_API_KEY is empty, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="StockPilot <no-reply@yourdomain.com>"

# WhatsApp alerts (optional) — Meta WhatsApp Business Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Without these, WhatsApp messages are printed to the server log instead.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved UTILITY template with two body variables: {{1}} = title, {{2}} = message
WHATSAPP_TEMPLATE_NAME=stockpilot_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0

# Offline mode (service worker) is on by default, in `bun run dev` and in production.
# Set to true only if you want to switch it off.
NEXT_PUBLIC_DISABLE_OFFLINE=false

# Seed / first super admin
SUPER_ADMIN_EMAIL=admin@stockpilot.ng
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Platform Admin"
